# Zeka Ajanı - API Anahtarları
# Bu dosyayı .env olarak kopyalayın ve anahtarlarınızı girin

# Groq API (Birincil - ÖNERİLEN)
# https://console.groq.com adresinden ücretsiz API anahtarı alın
GROQ_API_KEY=gsk_...

# OpenRouter API (Yedek)
# https://openrouter.ai adresinden ücretsiz API anahtarı alın
OPENROUTER_API_KEY=sk-or-v1-...
