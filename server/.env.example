# Call server (server/index.js) ortam değişkenleri.
# Bu dosyayı server/.env olarak kopyala ve değerleri doldur.
# Boş bırakılan motorlar sunucu tarafından "not configured" (503) döner.

PORT=3001

# LiveKit Cloud -> https://cloud.livekit.io (Project Settings)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# Agora.io -> https://console.agora.io (Project Config)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Daily.co -> https://dashboard.daily.co (API Keys)
DAILY_API_KEY=
